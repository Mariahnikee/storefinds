# Public browser values (safe to expose; restrict them in Supabase)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Server-only Netlify environment variables — NEVER use VITE_ prefix
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
PAYSTACK_SECRET_KEY=sk_test_replace_me
ADMIN_TOKEN=replace_with_a_long_random_secret
SITE_URL=https://your-production-site.netlify.app

# Existing Sanity catalogue
SANITY_PROJECT_ID=s13wiqvi
SANITY_DATASET=production

# Mailgun (use a verified sending domain/address)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=Shop MK Finds <orders@your-verified-domain.com>
